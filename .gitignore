# Environment and models (multi-GB, fetched by the setup steps in the README)
.venv/
hf/

# Pristine copies of MAX's own source, made by max_patch.py before patching.
# MAX is licensed under the Modular MAX Community License; its source is not
# redistributable here, so these stay local.
*.orig

# `dagr build` output. gen/mojo is committed — the Dagr CLI is not public yet, so a clone
# cannot regenerate it, and nothing here compiles without it. gen/python is not: it carries
# the Dagr schema DSL and layout engine, which are toolchain internals rather than output
# for these schemas.
gen/python/
.dagr/

# Generated from MAX's own instrument table by gen_prom_table.py. Not committed: it embeds
# MAX's metric descriptions. Anyone reproducing this has MAX installed and can generate it.
prom_table.mojo

# Generated from record_spec.py by gen_record_code.py (no Dagr CLI needed).
metrics_record_gen.mojo

# Build output
*.so
prom_agg
otlp_push
telemetry_server
__pycache__/
*.pyc

# Run artifacts: server logs, metric scrapes, record streams (50 MB+ per run).
# Curated numbers live in results/ and in the write-up.
runs/
