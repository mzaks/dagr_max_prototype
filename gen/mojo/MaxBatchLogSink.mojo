struct BatchLogHeaderAccessor[o: ImmOrigin](Copyable, Movable, ImplicitlyCopyable):
    var buf: Span[UInt8, Self.o]
    var pos: Int     # node start position (dedup key for eager restore)
    var _p0: Int   # tag position of field 0 (producer); -1 = absent
    var _p1: Int   # tag position of field 1 (model); -1 = absent
    var _p2: Int   # tag position of field 2 (max_batch_size); -1 = absent

    def __init__(out self, buf: Span[UInt8, Self.o], start: Int) raises:
        self.buf = buf
        self.pos = start
        var r = read_leb(buf, start)
        var cursor = start + r[1]
        var end = cursor + Int(r[0])
        self._p0 = -1
        if cursor < end:
            var t0 = read_leb(buf, cursor)
            if (t0[0] >> 1) == 0:
                self._p0 = cursor
                cursor += t0[1]
                var _l0 = read_leb(buf, cursor)
                cursor += _l0[1] + Int(_l0[0])
        self._p1 = -1
        if cursor < end:
            var t1 = read_leb(buf, cursor)
            if (t1[0] >> 1) == 1:
                self._p1 = cursor
                cursor += t1[1]
                var _l1 = read_leb(buf, cursor)
                cursor += _l1[1] + Int(_l1[0])
        self._p2 = -1
        if cursor < end:
            var t2 = read_leb(buf, cursor)
            if (t2[0] >> 1) == 2:
                self._p2 = cursor
                var raw2 = (t2[0] & 1) == 1
                cursor += t2[1]
                if raw2:
                    cursor += 4
                else:
                    cursor += read_leb(buf, cursor)[1]

    def producer(self) raises -> String:
        if self._p0 < 0:
            raise Error("missing required field producer")
        var t = read_leb(self.buf, self._p0)
        var payload = self._p0 + t[1]
        return String(read_utf8(self.buf, payload)[0])

    def model(self) raises -> String:
        if self._p1 < 0:
            raise Error("missing required field model")
        var t = read_leb(self.buf, self._p1)
        var payload = self._p1 + t[1]
        return String(read_utf8(self.buf, payload)[0])

    def max_batch_size(self) raises -> UInt32:
        if self._p2 < 0:
            raise Error("missing required field max_batch_size")
        var t = read_leb(self.buf, self._p2)
        var raw = (t[0] & 1) == 1
        var payload = self._p2 + t[1]
        if raw:
            return read_u32(self.buf, payload)
        else:
            return UInt32(read_leb(self.buf, payload)[0])


