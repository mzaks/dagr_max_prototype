        _ = self._b.store_leb(UInt64(self._b.cursor - _before))   # content_size
        _push_leb(self._rec, 1)
        self._b.emit_reversed_into(self._rec)
        _push_rleb(self._rec, UInt64(len(self._rec)))
        self.destination.write(Span(self._rec))
        self._pos += len(self._rec)
        self.last_range = MaxBatchLogRecord(1, _rs + 1, 0, 0, _rs - self.records_start, self._pos - self.records_start)
    def append_completed_batch(mut self, rec: CompletedBatch) raises:
        self.ensure_framing()
        var _rs = self._pos
        self._rec.clear()
        self._b.reset()
        _store_completed_batch(self._b, rec)   # writes [blockLen][fields]
        _push_leb(self._rec, 2)
        self._b.emit_reversed_into(self._rec)
        _push_rleb(self._rec, UInt64(len(self._rec)))
        self.destination.write(Span(self._rec))
        self._pos += len(self._rec)
        self.last_range = MaxBatchLogRecord(2, _rs + 1, 0, 0, _rs - self.records_start, self._pos - self.records_start)
    def flush(mut self) raises:
        self.destination.flush()


struct MaxBatchLogReader[o: ImmOrigin](Copyable, Movable):
