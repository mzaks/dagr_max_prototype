        self.destination.write(Span(self._rec))
        self._pos += len(self._rec)
        self.last_range = MaxBatchLogRecord(0, _rs + 1, 0, 0, _rs - self.records_start, self._pos - self.records_start)
    def append_batch_type(mut self, v: UInt8) raises:
        self.ensure_framing()
        var _rs = self._pos
        self._rec.clear()
        self._b.reset()
