# Forward LEB128 push (the Builder grows backward; the stream is forward).
def _push_leb(mut out: List[UInt8], v: UInt64):
    var x = v
    while True:
        var byte = UInt8(x & 0x7f)
        x >>= 7
        if x != 0:
            out.append(byte | 0x80)
        else:
            out.append(byte)
            break

def _push_bytes(mut out: List[UInt8], bytes: List[UInt8]):
    for i in range(len(bytes)):
        out.append(bytes[i])


def _push_rleb(mut out: List[UInt8], v: UInt64):
    var tmp = List[UInt8]()
    var x = v
    while True:
        var byte = UInt8(x & 0x7f)
        x >>= 7
        if x != 0:
            tmp.append(byte | 0x80)
        else:
            tmp.append(byte)
            break
    for i in range(len(tmp) - 1, -1, -1):
        out.append(tmp[i])


