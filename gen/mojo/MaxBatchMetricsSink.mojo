struct MetricsLogHeaderAccessor[o: ImmOrigin](Copyable, Movable, ImplicitlyCopyable):
    var buf: Span[UInt8, Self.o]
    var pos: Int     # node start position (dedup key for eager restore)
    var _p0: Int   # tag position of field 0 (producer); -1 = absent
    var _p1: Int   # tag position of field 1 (model); -1 = absent

    def __init__(out self, buf: Span[UInt8, Self.o], start: Int) raises:
        self.buf = buf
        self.pos = start
        var r = read_leb(buf, start)
        var cursor = start + r[1]
        var end = cursor + Int(r[0])
        self._p0 = -1
        if cursor < end:
            var t0 = read_leb(buf, cursor)
            if (t0[0] >> 1) == 0:
                self._p0 = cursor
                cursor += t0[1]
                var _l0 = read_leb(buf, cursor)
                cursor += _l0[1] + Int(_l0[0])
        self._p1 = -1
        if cursor < end:
            var t1 = read_leb(buf, cursor)
            if (t1[0] >> 1) == 1:
                self._p1 = cursor
                cursor += t1[1]
                var _l1 = read_leb(buf, cursor)
                cursor += _l1[1] + Int(_l1[0])

    def producer(self) raises -> String:
        if self._p0 < 0:
            raise Error("missing required field producer")
        var t = read_leb(self.buf, self._p0)
        var payload = self._p0 + t[1]
        return String(read_utf8(self.buf, payload)[0])

    def model(self) raises -> String:
        if self._p1 < 0:
            raise Error("missing required field model")
        var t = read_leb(self.buf, self._p1)
        var payload = self._p1 + t[1]
        return String(read_utf8(self.buf, payload)[0])


@fieldwise_init
struct MetricsLogHeader(Copyable, Movable):
    var producer: String
    var model: String

def _restore_metrics_log_header[o: ImmOrigin](buf: Span[UInt8, o], at: Int) raises -> MetricsLogHeader:
    var _r = read_leb(buf, at)
    var cursor = at + _r[1]
    var end = cursor + Int(_r[0])
    var _f0: String = String("")
    if cursor < end:
        var t0 = read_leb(buf, cursor)
        if (t0[0] >> 1) == 0:
            cursor += t0[1]
            var _u0 = read_utf8(buf, cursor)
            var _x0 = String(_u0[0])
            cursor += _u0[1]
            _f0 = _x0^
    var _f1: String = String("")
    if cursor < end:
        var t1 = read_leb(buf, cursor)
        if (t1[0] >> 1) == 1:
            cursor += t1[1]
            var _u1 = read_utf8(buf, cursor)
            var _x1 = String(_u1[0])
            cursor += _u1[1]
            _f1 = _x1^
    return MetricsLogHeader(producer=_f0^, model=_f1^)

def _store_metrics_log_header(mut b: Builder[_VT_MAX], rec: MetricsLogHeader) raises:
    var _before = b.cursor
    _ = b.store_utf8(rec.model, False)
    _ = b.store_leb(UInt64(3))
    _ = b.store_utf8(rec.producer, False)
    _ = b.store_leb(UInt64(1))
    _ = b.store_leb(UInt64(b.cursor - _before))   # blockLen (== content_size)


@fieldwise_init
struct MaxBatchMetricsRecord(Copyable, Movable, ImplicitlyCopyable):
    var type_id: Int
    var body: Int        # position right after the typeId (node blockLen starts here)
    var value_at: Int    # position after the content_size LEB (enum/union value)
    var size: Int        # content byte count
    var start: Int       # 32 §3.1: record range RELATIVE to records_start ([typeId] byte)
    var end: Int         # exclusive; includes the trailing RLEB span (doubly-linked)
    def is_meta(self) -> Bool:
        return is_meta_type_id(self.type_id)


# 32 §4.2 — reserved meta-record typeId band: meta_types[i] ↔ 16384 + i.
comptime META_TYPE_ID_BASE = 16384
comptime META_TYPE_ID_END = 32767
def is_meta_type_id(type_id: Int) -> Bool:
    return type_id >= META_TYPE_ID_BASE and type_id <= META_TYPE_ID_END


struct MaxBatchMetricsWriter(Movable):
    var out: List[UInt8]
    var framed: Bool
    var _b: Builder[_VT_MAX]
    var records_start: Int   # absolute position of recordsStart in `out` (32 §5)
    var last_range: MaxBatchMetricsRecord   # 32 §3.1: range of the most recent append (start/end)
    var _header: MetricsLogHeader
    def __init__(out self, var header: MetricsLogHeader):
        self.out = List[UInt8]()
        self.framed = False
        self._b = Builder[_VT_MAX]()
        self.records_start = 0
        self.last_range = MaxBatchMetricsRecord(0, 0, 0, 0, 0, 0)
        self._header = header^
    def _ensure_framing(mut self) raises:
        if not self.framed:
            _push_leb(self.out, 3)   # DataSink bit + header bit
            var _hb = Builder[_VT_MAX]()
            _store_metrics_log_header(_hb, self._header)   # [blockLen][packed header fields]
            _push_bytes(self.out, _hb.make_data())
            self.framed = True
            self.records_start = len(self.out)
    def current_offset(self) -> Int:
        # 32 §3.3 — offset of the NEXT record's start, relative to records_start.
        return len(self.out) - self.records_start if self.framed else 0
    def append_batch_metrics_rec(mut self, rec: BatchMetricsRec) raises:
        self._ensure_framing()
        var _rs = len(self.out)
        self._b.reset()
        _store_batch_metrics_rec(self._b, rec)   # writes [blockLen][fields]
        _push_leb(self.out, 0)
        self._b.emit_reversed_into(self.out)
        _push_rleb(self.out, UInt64(len(self.out) - _rs))
        self.last_range = MaxBatchMetricsRecord(0, _rs + 1, 0, 0, _rs - self.records_start, len(self.out) - self.records_start)
    def append_metrics_batch_type(mut self, v: UInt8) raises:
        self._ensure_framing()
        var _rs = len(self.out)
        self._b.reset()
        var _before = self._b.cursor
        _ = self._b.store_u8(v)
        _ = self._b.store_leb(UInt64(self._b.cursor - _before))   # content_size
        _push_leb(self.out, 1)
        self._b.emit_reversed_into(self.out)
        _push_rleb(self.out, UInt64(len(self.out) - _rs))
        self.last_range = MaxBatchMetricsRecord(1, _rs + 1, 0, 0, _rs - self.records_start, len(self.out) - self.records_start)
    def append_completed_rec(mut self, rec: CompletedRec) raises:
        self._ensure_framing()
        var _rs = len(self.out)
        self._b.reset()
        _store_completed_rec(self._b, rec)   # writes [blockLen][fields]
        _push_leb(self.out, 2)
        self._b.emit_reversed_into(self.out)
        _push_rleb(self.out, UInt64(len(self.out) - _rs))
        self.last_range = MaxBatchMetricsRecord(2, _rs + 1, 0, 0, _rs - self.records_start, len(self.out) - self.records_start)
    def append_vision_rec(mut self, rec: VisionRec) raises:
        self._ensure_framing()
        var _rs = len(self.out)
        self._b.reset()
        _store_vision_rec(self._b, rec)   # writes [blockLen][fields]
        _push_leb(self.out, 3)
        self._b.emit_reversed_into(self.out)
        _push_rleb(self.out, UInt64(len(self.out) - _rs))
        self.last_range = MaxBatchMetricsRecord(3, _rs + 1, 0, 0, _rs - self.records_start, len(self.out) - self.records_start)
    def append_video_rec(mut self, rec: VideoRec) raises:
        self._ensure_framing()
        var _rs = len(self.out)
        self._b.reset()
        _store_video_rec(self._b, rec)   # writes [blockLen][fields]
        _push_leb(self.out, 4)
        self._b.emit_reversed_into(self.out)
        _push_rleb(self.out, UInt64(len(self.out) - _rs))
        self.last_range = MaxBatchMetricsRecord(4, _rs + 1, 0, 0, _rs - self.records_start, len(self.out) - self.records_start)
    def finish(mut self) raises -> List[UInt8]:
        self._ensure_framing()
        return self.out.copy()


struct MaxBatchMetricsStreamWriter[D: SinkDestination](Movable):
    var destination: Self.D
    var framed: Bool
    var _b: Builder[_VT_MAX]
    var _rec: List[UInt8]    # per-record scratch: one destination.write per record
    var _pos: Int            # absolute stream position = bytes handed to destination
    var records_start: Int   # absolute position of recordsStart in the stream (32 §5)
    var last_range: MaxBatchMetricsRecord   # 32 §3.1: range of the most recent append (start/end)
    var _header: MetricsLogHeader
    def __init__(out self, var destination: Self.D, var header: MetricsLogHeader):
        self.destination = destination^
        self.framed = False
        self._b = Builder[_VT_MAX]()
        self._rec = List[UInt8]()
        self._pos = 0
        self.records_start = 0
        self.last_range = MaxBatchMetricsRecord(0, 0, 0, 0, 0, 0)
        self._header = header^
    def ensure_framing(mut self) raises:
        if not self.framed:
            self._rec.clear()
            _push_leb(self._rec, 3)   # DataSink bit + header bit
            var _hb = Builder[_VT_MAX]()
            _store_metrics_log_header(_hb, self._header)   # [blockLen][packed header fields]
            _push_bytes(self._rec, _hb.make_data())
            self.destination.write(Span(self._rec))
            self._pos += len(self._rec)
            self.framed = True
            self.records_start = self._pos
    def current_offset(self) -> Int:
        # 32 §3.3 — offset of the NEXT record's start, relative to records_start.
        return self._pos - self.records_start if self.framed else 0
    def append_batch_metrics_rec(mut self, rec: BatchMetricsRec) raises:
        self.ensure_framing()
        var _rs = self._pos
        self._rec.clear()
        self._b.reset()
        _store_batch_metrics_rec(self._b, rec)   # writes [blockLen][fields]
        _push_leb(self._rec, 0)
        self._b.emit_reversed_into(self._rec)
        _push_rleb(self._rec, UInt64(len(self._rec)))
        self.destination.write(Span(self._rec))
        self._pos += len(self._rec)
        self.last_range = MaxBatchMetricsRecord(0, _rs + 1, 0, 0, _rs - self.records_start, self._pos - self.records_start)
    def append_metrics_batch_type(mut self, v: UInt8) raises:
        self.ensure_framing()
        var _rs = self._pos
        self._rec.clear()
        self._b.reset()
        var _before = self._b.cursor
        _ = self._b.store_u8(v)
        _ = self._b.store_leb(UInt64(self._b.cursor - _before))   # content_size
        _push_leb(self._rec, 1)
        self._b.emit_reversed_into(self._rec)
        _push_rleb(self._rec, UInt64(len(self._rec)))
        self.destination.write(Span(self._rec))
        self._pos += len(self._rec)
        self.last_range = MaxBatchMetricsRecord(1, _rs + 1, 0, 0, _rs - self.records_start, self._pos - self.records_start)
    def append_completed_rec(mut self, rec: CompletedRec) raises:
        self.ensure_framing()
        var _rs = self._pos
        self._rec.clear()
        self._b.reset()
        _store_completed_rec(self._b, rec)   # writes [blockLen][fields]
        _push_leb(self._rec, 2)
        self._b.emit_reversed_into(self._rec)
        _push_rleb(self._rec, UInt64(len(self._rec)))
        self.destination.write(Span(self._rec))
        self._pos += len(self._rec)
        self.last_range = MaxBatchMetricsRecord(2, _rs + 1, 0, 0, _rs - self.records_start, self._pos - self.records_start)
    def append_vision_rec(mut self, rec: VisionRec) raises:
        self.ensure_framing()
        var _rs = self._pos
        self._rec.clear()
        self._b.reset()
        _store_vision_rec(self._b, rec)   # writes [blockLen][fields]
        _push_leb(self._rec, 3)
        self._b.emit_reversed_into(self._rec)
        _push_rleb(self._rec, UInt64(len(self._rec)))
        self.destination.write(Span(self._rec))
        self._pos += len(self._rec)
        self.last_range = MaxBatchMetricsRecord(3, _rs + 1, 0, 0, _rs - self.records_start, self._pos - self.records_start)
    def append_video_rec(mut self, rec: VideoRec) raises:
        self.ensure_framing()
        var _rs = self._pos
        self._rec.clear()
        self._b.reset()
        _store_video_rec(self._b, rec)   # writes [blockLen][fields]
        _push_leb(self._rec, 4)
        self._b.emit_reversed_into(self._rec)
        _push_rleb(self._rec, UInt64(len(self._rec)))
        self.destination.write(Span(self._rec))
        self._pos += len(self._rec)
        self.last_range = MaxBatchMetricsRecord(4, _rs + 1, 0, 0, _rs - self.records_start, self._pos - self.records_start)
    def flush(mut self) raises:
        self.destination.flush()


struct MaxBatchMetricsReader[o: ImmOrigin](Copyable, Movable):
    var buf: Span[UInt8, Self.o]
    var pos: Int
    var records_start: Int   # absolute position of the first record byte (32 §5)
    var header: MetricsLogHeader
    def __init__(out self, buf: Span[UInt8, Self.o]) raises:
        self.buf = buf
        var fr = read_leb(buf, 0)      # framing word (header bit set)
        var _hat = fr[1]
        self.header = _restore_metrics_log_header(buf, _hat)   # packed header at fr[1]
        var _hbl = read_leb(buf, _hat)              # [blockLen][fields]
        self.pos = _hat + _hbl[1] + Int(_hbl[0])    # first record follows
        self.records_start = self.pos
    def has_next(self) -> Bool:
        return self.pos < len(self.buf)
    def raw_bytes(self, rec: MaxBatchMetricsRecord) -> Span[UInt8, Self.o]:
        # 32 §4.1 — the record's exact wire bytes, from its relative range.
        return self.buf[self.records_start + rec.start:self.records_start + rec.end]
    def next(mut self) raises -> MaxBatchMetricsRecord:
        var _rec_begin = self.pos             # start of [typeId] LEB (range start; span anchor, §11)
        var t = read_leb(self.buf, self.pos)
        var body = self.pos + t[1]                 # blockLen / content_size LEB
        var sz = read_leb(self.buf, body)
        var value_at = body + sz[1]
        var size = Int(sz[0])
        var _rec_end = value_at + size
        self.pos = _rec_end + leb_length(UInt64(_rec_end - _rec_begin))
        return MaxBatchMetricsRecord(Int(t[0]), body, value_at, size, _rec_begin - self.records_start, self.pos - self.records_start)

struct MaxBatchMetricsReverseReader[o: ImmOrigin](Copyable, Movable):
    var buf: Span[UInt8, Self.o]
    var pos: Int          # one past the current record's trailing RLEB
    var start: Int        # first record byte (end of framing/header)
    def __init__(out self, buf: Span[UInt8, Self.o]) raises:
        self.buf = buf
        self.pos = len(buf)
        var fr = read_leb(buf, 0)
        var rs = fr[1]
        if (Int(fr[0]) & 1) == 1:
            var hbl = read_leb(buf, fr[1])       # skip inline header block
            rs = fr[1] + hbl[1] + Int(hbl[0])
        self.start = rs
    def has_prev(self) -> Bool:
        return self.pos > self.start
    def prev(mut self) raises -> MaxBatchMetricsRecord:
        # Decode the trailing RLEB backward: walk left, LSB-first, stop at terminator.
        var value: UInt64 = 0
        var shift: UInt64 = 0
        var nbytes = 0
        var p = self.pos
        while True:
            p -= 1
            var b = self.buf[p]
            value += (UInt64(b) & 0x7F) << shift
            nbytes += 1
            if (b & 0x80) == 0:
                break
            shift += 7
        var body_end = self.pos - nbytes
        var rec_begin = body_end - Int(value)
        var _end = self.pos
        self.pos = rec_begin
        var t = read_leb(self.buf, rec_begin)
        var body = rec_begin + t[1]
        var sz = read_leb(self.buf, body)
        var value_at = body + sz[1]
        var size = Int(sz[0])
        return MaxBatchMetricsRecord(Int(t[0]), body, value_at, size, rec_begin - self.start, _end - self.start)
