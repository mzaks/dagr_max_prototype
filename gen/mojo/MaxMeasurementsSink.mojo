        return self.out.copy()


struct MaxMeasurementsStreamWriter[D: SinkDestination](Movable):
    var destination: Self.D
    var framed: Bool
    var _b: Builder[_VT_MAX]
    var _rec: List[UInt8]    # per-record scratch: one destination.write per record
    var _pos: Int            # absolute stream position = bytes handed to destination
    var records_start: Int   # absolute position of recordsStart in the stream (32 §5)
    var last_range: MaxMeasurementsRecord   # 32 §3.1: range of the most recent append (start/end)
    var _header: MeasurementLogHeader
    def __init__(out self, var destination: Self.D, var header: MeasurementLogHeader):
        self.destination = destination^
        self.framed = False
        self._b = Builder[_VT_MAX]()
        self._rec = List[UInt8]()
        self._pos = 0
        self.records_start = 0
        self.last_range = MaxMeasurementsRecord(0, 0, 0, 0, 0, 0)
        self._header = header^
    def ensure_framing(mut self) raises:
        if not self.framed:
            self._rec.clear()
            _push_leb(self._rec, 3)   # DataSink bit + header bit
            var _hb = Builder[_VT_MAX]()
            _store_measurement_log_header(_hb, self._header)   # [blockLen][packed header fields]
            _push_bytes(self._rec, _hb.make_data())
            self.destination.write(Span(self._rec))
            self._pos += len(self._rec)
            self.framed = True
            self.records_start = self._pos
    def current_offset(self) -> Int:
        # 32 §3.3 — offset of the NEXT record's start, relative to records_start.
        return self._pos - self.records_start if self.framed else 0
    def append_measurement_rec(mut self, rec: MeasurementRec) raises:
        self.ensure_framing()
        var _rs = self._pos
        self._rec.clear()
        self._b.reset()
        _store_measurement_rec(self._b, rec)   # writes [blockLen][fields]
        _push_leb(self._rec, 0)
        self._b.emit_reversed_into(self._rec)
        _push_rleb(self._rec, UInt64(len(self._rec)))
        self.destination.write(Span(self._rec))
        self._pos += len(self._rec)
        self.last_range = MaxMeasurementsRecord(0, _rs + 1, 0, 0, _rs - self.records_start, self._pos - self.records_start)
    def append_name_rec(mut self, rec: NameRec) raises:
        self.ensure_framing()
        var _rs = self._pos
        self._rec.clear()
        self._b.reset()
        _store_name_rec(self._b, rec)   # writes [blockLen][fields]
        _push_leb(self._rec, 1)
        self._b.emit_reversed_into(self._rec)
        _push_rleb(self._rec, UInt64(len(self._rec)))
        self.destination.write(Span(self._rec))
        self._pos += len(self._rec)
        self.last_range = MaxMeasurementsRecord(1, _rs + 1, 0, 0, _rs - self.records_start, self._pos - self.records_start)
    def append_attr_set_rec(mut self, rec: AttrSetRec) raises:
        self.ensure_framing()
        var _rs = self._pos
        self._rec.clear()
        self._b.reset()
        _store_attr_set_rec(self._b, rec)   # writes [blockLen][fields]
        _push_leb(self._rec, 2)
        self._b.emit_reversed_into(self._rec)
        _push_rleb(self._rec, UInt64(len(self._rec)))
        self.destination.write(Span(self._rec))
        self._pos += len(self._rec)
        self.last_range = MaxMeasurementsRecord(2, _rs + 1, 0, 0, _rs - self.records_start, self._pos - self.records_start)
    def flush(mut self) raises:
        self.destination.flush()


struct MaxMeasurementsReader[o: ImmOrigin](Copyable, Movable):
    var buf: Span[UInt8, Self.o]
    var pos: Int
    var records_start: Int   # absolute position of the first record byte (32 §5)
    var header: MeasurementLogHeader
    def __init__(out self, buf: Span[UInt8, Self.o]) raises:
        self.buf = buf
        var fr = read_leb(buf, 0)      # framing word (header bit set)
        var _hat = fr[1]
        self.header = _restore_measurement_log_header(buf, _hat)   # packed header at fr[1]
        var _hbl = read_leb(buf, _hat)              # [blockLen][fields]
        self.pos = _hat + _hbl[1] + Int(_hbl[0])    # first record follows
        self.records_start = self.pos
    def has_next(self) -> Bool:
        return self.pos < len(self.buf)
    def raw_bytes(self, rec: MaxMeasurementsRecord) -> Span[UInt8, Self.o]:
        # 32 §4.1 — the record's exact wire bytes, from its relative range.
        return self.buf[self.records_start + rec.start:self.records_start + rec.end]
    def next(mut self) raises -> MaxMeasurementsRecord:
        var _rec_begin = self.pos             # start of [typeId] LEB (range start; span anchor, §11)
        var t = read_leb(self.buf, self.pos)
        var body = self.pos + t[1]                 # blockLen / content_size LEB
        var sz = read_leb(self.buf, body)
        var value_at = body + sz[1]
        var size = Int(sz[0])
        var _rec_end = value_at + size
        self.pos = _rec_end + leb_length(UInt64(_rec_end - _rec_begin))
        return MaxMeasurementsRecord(Int(t[0]), body, value_at, size, _rec_begin - self.records_start, self.pos - self.records_start)

struct MaxMeasurementsReverseReader[o: ImmOrigin](Copyable, Movable):
    var buf: Span[UInt8, Self.o]
    var pos: Int          # one past the current record's trailing RLEB
    var start: Int        # first record byte (end of framing/header)
    def __init__(out self, buf: Span[UInt8, Self.o]) raises:
        self.buf = buf
        self.pos = len(buf)
        var fr = read_leb(buf, 0)
        var rs = fr[1]
        if (Int(fr[0]) & 1) == 1:
            var hbl = read_leb(buf, fr[1])       # skip inline header block
            rs = fr[1] + hbl[1] + Int(hbl[0])
        self.start = rs
    def has_prev(self) -> Bool:
        return self.pos > self.start
    def prev(mut self) raises -> MaxMeasurementsRecord:
        # Decode the trailing RLEB backward: walk left, LSB-first, stop at terminator.
        var value: UInt64 = 0
        var shift: UInt64 = 0
        var nbytes = 0
        var p = self.pos
        while True:
            p -= 1
            var b = self.buf[p]
            value += (UInt64(b) & 0x7F) << shift
            nbytes += 1
            if (b & 0x80) == 0:
                break
            shift += 7
        var body_end = self.pos - nbytes
        var rec_begin = body_end - Int(value)
        var _end = self.pos
        self.pos = rec_begin
        var t = read_leb(self.buf, rec_begin)
        var body = rec_begin + t[1]
        var sz = read_leb(self.buf, body)
        var value_at = body + sz[1]
        var size = Int(sz[0])
        return MaxMeasurementsRecord(Int(t[0]), body, value_at, size, rec_begin - self.start, _end - self.start)
