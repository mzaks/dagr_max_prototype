        var _rs = len(self.out)
        self._b.reset()
        _store_name_rec(self._b, rec)   # writes [blockLen][fields]
        _push_leb(self.out, 1)
        self._b.emit_reversed_into(self.out)
        _push_rleb(self.out, UInt64(len(self.out) - _rs))
        self.last_range = MaxMeasurementsRecord(1, _rs + 1, 0, 0, _rs - self.records_start, len(self.out) - self.records_start)
