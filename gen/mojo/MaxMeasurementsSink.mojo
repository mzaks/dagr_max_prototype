# 32 §4.2 — reserved meta-record typeId band: meta_types[i] ↔ 16384 + i.
comptime META_TYPE_ID_BASE = 16384
comptime META_TYPE_ID_END = 32767
def is_meta_type_id(type_id: Int) -> Bool:
    return type_id >= META_TYPE_ID_BASE and type_id <= META_TYPE_ID_END


